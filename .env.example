# Copy to .env and fill in real values. NEVER commit .env.

# Job source: "greenhouse" (Irish jobs, no key needed) or "adzuna" (needs keys
# below; Adzuna does not cover Ireland, so set ADZUNA_COUNTRY e.g. gb)
# JOB_SOURCE=greenhouse
# GREENHOUSE_BOARDS=["stripe","intercom","mongodb"]

# Adzuna job search API (free): https://developer.adzuna.com
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# Groq LLM API (free): https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Path to your CV, used to score how well each job fits you
CV_PATH=C:/Users/you/Documents/cv.docx

# Optional overrides:
# LLM_MODEL=openai/gpt-oss-120b
# ADZUNA_COUNTRY=gb
# DB_PATH=data/applications.db
